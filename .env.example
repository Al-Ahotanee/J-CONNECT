# ==========================================
# J-CONNECT CONFIGURATION (AIVEN MYSQL & NODE)
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Aiven MySQL Database Connection
# Option 1: Full Aiven Connection URI
# MYSQL_URL="mysql://avnadmin:your_password@mysql-xxxxx-jconnect.a.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED"

# Option 2: Individual Connection Parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=defaultdb
MYSQL_SSL=false
MYSQL_REJECT_UNAUTHORIZED=false

# Authentication
JWT_SECRET=jconnect_super_secure_jwt_secret_key_2026

# AI Engine (Optional - Google Gemini or OpenAI)
GEMINI_API_KEY=
